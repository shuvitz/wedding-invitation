# Base URL for Laravel's public JSON API (see routes/api.php's "public"
# group in the main repo). Used both server-to-server during SSR and,
# after the page hydrates in the browser, for client-side navigation — so
# it must be a real, publicly reachable URL in production, not an internal
# one.
#
# REQUIRED in production: `npm run build` fails immediately if this is
# unset and NODE_ENV=production (i.e. every Netlify build) — see
# nuxt.config.ts and ../DEPLOYMENT.md's "Troubleshooting" section. This
# prevents a forgotten env var from silently deploying a site that tries
# to call localhost from Netlify's servers.
#
# Local development (php artisan serve on its default port) — optional,
# nuxt.config.ts already falls back to this same value in dev:
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/public

# Production example (Laravel deployed on its own domain via shared
# hosting — the Netlify-deployed Nuxt app calls it cross-origin, so this
# domain must also be added to CORS_ALLOWED_ORIGINS in Laravel's .env):
# NUXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/public

# Locale for formatting dates in blocks (e.g. `schedule`). Optional,
# defaults to `en`; set `id` for "Sabtu, 14 Juni 2026". Keep it in step
# with Laravel's APP_LOCALE so the Blade and Nuxt renderers agree.
# NUXT_PUBLIC_LOCALE=id
